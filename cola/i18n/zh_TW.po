#: cola/sequenceeditor.py:946
msgid ""
"\n"
"Commands\n"
"--------\n"
"pick = use commit\n"
"reword = use commit, but edit the commit message\n"
"edit = use commit, but stop for amending\n"
"squash = use commit, but meld into previous commit\n"
"fixup = like \"squash\", but discard this commit's log message\n"
"exec = run command (the rest of the line) using shell\n"
"break = stop here (continue rebase later)\n"
"drop = remove commit\n"
"label = label current HEAD with a name\n"
"reset = reset HEAD to a label\n"
"merge = create a merge commit\n"
"update-ref = update branches that point to commits\n"
"\n"
"These lines can be re-ordered; they are executed from top to bottom.\n"
"\n"
"If you disable a line here THAT COMMIT WILL BE LOST.\n"
"\n"
"However, if you disable everything, the rebase will be aborted.\n"
"\n"
"Keyboard Shortcuts\n"
"------------------\n"
"? = show help\n"
"j = move down\n"
"k = move up\n"
"J = shift row down\n"
"K = shift row up\n"
"\n"
"1, p = pick\n"
"2, r = reword\n"
"3, e = edit\n"
"4, f = fixup\n"
"5, s = squash\n"
"6, d = drop\n"
"spacebar = toggle enabled\n"
"\n"
"ctrl+enter = accept changes and rebase\n"
"ctrl+q     = cancel and abort the rebase\n"
"ctrl+d     = launch difftool\n"
msgstr ""
"\n"
"命令\n"
"--------\n"
"pick = 使用此修訂版提交\n"
"reword = 使用此修訂版提交，但是編輯其提交訊息\n"
"edit = 使用此修訂版提交，但是在此處暫停以修正(amend)其內容\n"
"squash = 使用此修訂版提交，但是與前一個修訂版提交合併\n"
"fixup = 像是「squash」，但是丟棄此修訂版提交的訊息\n"
"exec = 使用 shell 執行命令（此行剩下的內容）\n"
"break = 在這裡暫停（之後再繼續變更基底）\n"
"drop = 移除此修訂版提交\n"
"label = 使用一個標籤(label)標記當前 HEAD 指標指向的修訂版\n"
"reset = 將 HEAD 指標重設至一個標籤(label)\n"
"merge = 創建一個合併提交(merge commit)\n"
"update-ref = 更新指向修訂版提交的分支\n"
"\n"
"這些行可以被更動順序；它們會被由上至下執行\n"
"\n"
"如果你禁用一行則該修訂版提交 將 被 丟 失 。\n"
"\n"
"但是，如果你將所有行都禁用，變更基底操作則會被中止。\n"
"\n"
"鍵盤快捷鍵\n"
"------------------\n"
"? = 顯示本求助資訊\n"
"j = 往下移動\n"
"k = 往上移動\n"
"J = 將本行往下平移\n"
"K = 將本行往上平移\n"
"\n"
"1, p = pick\n"
"2, r = reword\n"
"3, e = edit\n"
"4, f = fixup\n"
"5, s = squash\n"
"6, d = drop\n"
"空白鍵 = 切換啟用/禁用開關\n"
"\n"
"ctrl+enter = 接受變更並進行變更基底操作\n"
"ctrl+q     = 取消並中止變更基底操作\n"
"ctrl+d     = 啟動內容差異檢視工具\n"

