#compdef git-fanta
#description zsh completion for git-fanta
#
# The recommended way to install this script is to make a copy of it as a
# file named '_git-fanta' inside any directory in your fpath.
#
# For example, create a directory '~/.config/zsh/completion',
# copy this file to '~/.config/zsh/completion/_git-fanta',
# and then add the following to your ~/.zshrc file:
#
#  fpath=(~/.config/zsh/completion $fpath)

__git-fanta_common_options () {
	# these can't be prefixed
	_arguments '--help[Show help]' \
		'--icon-theme=-[specify an icon theme name or directory]:theme:(dark light default)' \
		'--theme=-[specify a GUI theme name]:theme:(dark light default)' \
		'--prompt[prompt for a repository]' \
		'--repo=-[open the specified git repository]:repository:_files -/' \
		'--version[print version number]'
}

_git-fanta_refs () {
	typeset -a refs
	local ref

	if git rev-parse HEAD >/dev/null 2>&1
	then
		for ref in $(git for-each-ref --format='%(refname:short)')
		do
			refs+=(${ref})
		done

		(( $#refs )) && _describe -t refs 'refs' refs
	fi

}

_git-fanta-am () {
	__git-fanta_common_options
	_arguments \
		'*:patches:_files -g "*.patch"'
}

_git-fanta-archive () {
	__git-fanta_common_options
	_arguments \
		':ref:_git-fanta_refs'
}

_git-fanta-cola () {
	__git-fanta_common_options
	_arguments \
		'--status-filter=-[status path filter]:path:_files'
}

_git-fanta-dag () {
	__git-fanta_common_options
	_arguments \
		'--all[show all branches]' \
		'*:refs:_git-fanta_refs'
}

_git-fanta-diff () {
	__git-fanta_common_options
	_arguments \
		'*:refs:_git-fanta_refs'
}

_git-fanta-find () {
	__git-fanta_common_options
	_arguments \
		':path:_files'
}

_git-fanta-grep () {
	__git-fanta_common_options
	_arguments \
		'*:path:_files'
}

_git-fanta-merge () {
	__git-fanta_common_options
	_arguments \
		':ref:_git-fanta_refs'
}

_git-fanta-rebase () {
	__git-fanta_common_options
	_arguments \
		'--autosquash[move commits that begin with squash!/fixup!]' \
		'--autostash[automatically stash/stash pop before and after]' \
		'--fork-point[use "merge-base --fork-point" to refine upstream]' \
		'--onto=-[rebase onto given branch instead of upstream]:ref:_git-fanta_refs' \
		'--preserve-merges[try to recreate merges instead of ignoring them]' \
		'--root[rebase all reachable commits up to the root(s)]' \
		'--strategy=-[use the given merge strategy]:strategy:(recursive resolve octopus ort ours subtree)' \
		'--verify[allow pre-rebase hook to run]' \
		'--continue[continue]' \
		'--abort[abort and check out the original branch]' \
		'--skip[skip current patch and continue]' \
		'--edit-todo[edit the todo list]' \
		':ref:_git-fanta_refs' \
		':ref:_git-fanta_refs'
}

_git-fanta-tag () {
	__git-fanta_common_options
	_arguments \
		'--sign[annotated and GPG-signed tag]' \
		':tag name:' \
		':ref:_git-fanta_refs'
}


_git-fanta () {
	local curcontext="$curcontext" state line
	typeset -A opt_args
	_arguments -C \
		':command:->command' \
		'*::options:->options' \

	case $state in
	(command)
		#breaks if defined outside the func
		local -a subcommands
		subcommands=(
			'about:about git-fanta'
			'am:apply patches using "git am"'
			'archive:save an archive'
			'branch:create a branch'
			'browse:browse repository'
			'clone:clone repository'
			'cola:start git-fanta'
			'config:edit configuration'
			'dag:visualize branch history'
			'diff:view diffs'
			'fetch:fetch remotes'
			'find:find files'
			'grep:grep source'
			'merge:merge branches'
			'pull:pull remote branches'
			'push:push remote branches'
			'rebase:interactive rebase'
			'recent:edit recent files'
			'remote:edit remotes'
			'search:search commits'
			'stash:stash and unstash changes'
			'tag:create tags'
			'version:print the version'
			'--help-commands:show available sub-commands'
		)

		_describe -t commands git-fanta subcommands
	;;
	(options)
		local funcname
		funcname=_git-fanta-$line[1]
		if type $funcname | grep -q 'shell function'
		then
			$funcname
		else
			__git-fanta_common_options
		fi
	;;
	esac
}

_git-fanta "$@"
